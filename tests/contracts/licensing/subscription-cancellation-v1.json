{
  "contract": "subscription-cancellation",
  "version": 1,
  "policyVersion": "term-boundary/1",
  "pageSize": 100,
  "publicPath": "/api/billing/accounts/{accountId}/subscriptions/{termId}/cancellation",
  "internalPath": "/internal/licensing/v1/customer/accounts/{accountId}/subscriptions/{termId}/cancellation",
  "providerPath": "/api/admin/accounts/{accountId}/subscriptions/{termId}/cancellation",
  "actions": {
    "read": "billing.subscription.cancellation.read",
    "schedule": "billing.subscription.cancellation.schedule",
    "recover": "billing.subscription.cancellation.recover"
  },
  "acceptanceExample": {
    "operationKey": "00000000-0000-0000-0000-000000000001",
    "expectedVersion": 0,
    "sourceHash": "1111111111111111111111111111111111111111111111111111111111111111",
    "acceptedEffectiveAt": "2027-02-28T04:30:00+00:00",
    "affectedShopSetHash": "2222222222222222222222222222222222222222222222222222222222222222",
    "affectedShopCount": 2,
    "policyVersion": "term-boundary/1",
    "confirmed": true
  },
  "retained": ["paidThrough", "basis", "pricePaise", "termId"],
  "receiptScope": "same live billing actor, account, term and operation key",
