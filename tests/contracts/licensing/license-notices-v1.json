{
  "contract": "license-notices",
  "version": 1,
  "actions": {
    "shopRead": {
      "action": "licensing.shop-notices.read",
      "scope": "actor",
      "method": "GET",
      "path": "/internal/licensing/v1/customer/shops/{shopId}/notices",
      "continuation": "/internal/licensing/v1/customer/shops/{shopId}/notices/after/{noticeId}",
      "bodySha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    "accountRead": {
      "action": "licensing.account-notices.read",
      "scope": "account",
      "roles": ["Owner", "Manager"],
      "method": "GET",
      "path": "/internal/licensing/v1/customer/accounts/{accountId}/notices",
      "continuation": "/internal/licensing/v1/customer/accounts/{accountId}/notices/after/{noticeId}"
    },
    "contactList": {
      "action": "licensing.notice-contacts.list",
      "scope": "account",
      "roles": ["Owner"],
      "method": "GET",
      "path": "/internal/licensing/v1/customer/accounts/{accountId}/notice-contacts",
      "continuation": "/internal/licensing/v1/customer/accounts/{accountId}/notice-contacts/after/{contactId}"
    },
    "recipientAuthority": {
      "method": "POST",
      "path": "/internal/merchant/v1/licensing/notice-recipients",
      "proofHeader": "X-Licensing-Notice-Recipients-Proof"
    }
  },
  "publicRoutes": {
    "merchantShop": "GET /api/licensing/shops/{shopId}/notices?after= (live active-shop member, current operational guidance only)",
    "merchantAccount": "GET /api/billing/accounts/{accountId}/notices?after= (verified Billing Owner/Manager, current per-source commercial notices)",
    "merchantContacts": "GET /api/billing/accounts/{accountId}/notice-contacts?after= (verified Billing Owner, paged without verification secrets)",
    "providerAccount": "GET /api/admin/accounts/{accountId}/notifications?after= (Support redacted; Billing or Licensing Manager commercial)"
  },
  "bounds": {
    "pageSize": 50,
    "contactPageSize": 25,
