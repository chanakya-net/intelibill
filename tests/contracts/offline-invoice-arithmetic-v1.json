{
  "contract": "offline-invoice-arithmetic",
  "calculationVersion": 1,
  "rounding": "Money in paise, quantity in thousandths, percentages in basis points; every division rounds half away from zero. A tax-inclusive line with a positive rate totals its shelf price (price x quantity) less the tax-inclusive equivalent of its discounts, and its tax is that total less its taxable value, as online sales do; an exclusive line totals taxable value plus rounded tax.",
  "allocation": "Sale discount: floor share per goods line with positive taxable value, capped at that value; leftover paise to the largest remainders, ties by line order.",
  "cases": [
    {
      "name": "exclusive_single_line",
      "input": {
        "lines": [
          {
            "lineType": "goods",
            "quantity": 1,
            "salesPrice": 100,
            "taxRatePercent": 18,
            "taxIncluded": false,
            "itemDiscount": {
              "type": 0,
              "value": 0
            },
            "batchRulePercentage": null
          }
        ],
        "saleDiscount": {
          "type": 0,
          "value": 0
        },
        "saleRule": null,
        "paidAmount": 118
      },
      "expected": {
        "lines": [
          {
            "preTaxAmount": 100,
            "itemDiscountAmount": 0,
            "saleDiscountAmount": 0,
            "taxableAmount": 100,
            "taxAmount": 18,
            "lineTotal": 118
          }
        ],
        "totals": {
          "subtotalBeforeDiscount": 100,
          "totalBeforeDiscount": 118,
          "totalDiscount": 0,
          "totalTax": 18,
          "grandTotal": 118,
          "paidAmount": 118,
          "dueAmount": 0
        }
      }
    },
