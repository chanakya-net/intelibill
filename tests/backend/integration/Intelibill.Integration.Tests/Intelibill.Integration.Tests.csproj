<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1707;CA1852</NoWarn>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)integration.runsettings</RunSettingsFilePath>
    <!--
      Classes run side by side and each keeps API hosts busy, some of it in blocking calls
      (host start and dispose). The thread pool starts with one thread per processor and adds
      more only slowly, so on a 4-processor CI runner continuations queued behind blocked threads
      for seconds and tests with short waits timed out. Start with enough threads instead.
    -->
    <ThreadPoolMinThreads>64</ThreadPoolMinThreads>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../../shared/IntegrationTestRuntime.cs" Link="IntegrationTestRuntime.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../src/backend/Intelibill.Api/Intelibill.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../contracts/licensing/shop-trading-authority-v1.json"
          Link="shop-trading-authority-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../contracts/licensing/offline-permit-v1.json"
          Link="offline-permit-v1.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
