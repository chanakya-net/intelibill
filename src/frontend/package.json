{
  "name": "inventory",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "NODE_NO_WARNINGS=1 ng serve",
    "build": "ng build && bun run build:server",
    "watch": "ng build --watch --configuration development",
    "test": "node ./scripts/test-runner.mjs",
    "audit:styles": "bun run scripts/audit-unused-styles.mjs",
    "audit:ui:setup": "bun run scripts/run-ui-audit.mjs --setup",
    "audit:ui": "bun run scripts/run-ui-audit.mjs",
    "audit:ui:mocked": "bun run scripts/run-ui-audit.mjs --mocked",
    "audit:ui:baseline": "bun run scripts/run-ui-audit.mjs --baseline",
    "build:server": "bun build src/server.ts --target=node --outfile=dist/INVENTORY/server/server.mjs",
    "serve": "node dist/INVENTORY/server/server.mjs"
  },
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=24.0.0 <26"
  },
  "dependencies": {
    "@angular/animations": "^21.2.6",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/service-worker": "^21.2.0",
    "@hono/node-server": "^1.19.13",
    "@microsoft/signalr": "^10.0.0",
    "@ngneat/transloco": "^6.0.4",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/entity": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "@primeuix/themes": "^2.0.3",
    "@tailwindcss/postcss": "^4.2.2",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "chart.js": "^4.5.1",
    "express": "^5.1.0",
    "hono": "^4.12.12",
    "http-proxy-middleware": "^4.2.0",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.8",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "vite": "^8.0.8"
  },
  "devDependencies": {
    "@angular/build": "^21.2.4",
    "@angular/cli": "^21.2.4",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "1.62.0",
    "@types/express": "^5.0.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.2",
    "jsdom": "^28.0.0",
    "postcss-scss": "^4.0.9",
    "postcss-selector-parser": "^7.1.4",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
