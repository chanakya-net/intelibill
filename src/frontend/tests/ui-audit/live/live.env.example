# Copy to a gitignored .env file or set these variables in the runtime shell.
INTELIBILL_LIVE_USERNAME=user@example.test
INTELIBILL_LIVE_PASSWORD=replace-at-runtime

# Optional; defaults shown.
INTELIBILL_LIVE_API_URL=http://localhost:5277/api
INTELIBILL_LIVE_APP_URL=http://localhost:4200

# To load another ignored file, set this in the runtime shell:
# INTELIBILL_LIVE_ENV_FILE=/absolute/path/to/live-credentials.env
