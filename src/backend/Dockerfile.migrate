# Run EF design-time code on the native build host while publishing the bundle
# for the requested Container Apps architecture.
FROM --platform=$BUILDPLATFORM mcr.microsoft.com/dotnet/sdk:10.0@sha256:e1ffd2a92ae84c1291bc1b6887501f8af98e6331e7af6d4c8d37168c5e87a64c AS build
WORKDIR /src

COPY ["global.json", "./"]
COPY ["Directory.Build.props", "./"]
COPY ["Directory.Packages.props", "./"]
COPY ["src/backend/Intelibill.Api/Intelibill.Api.csproj", "src/backend/Intelibill.Api/"]
COPY ["src/backend/Intelibill.Application/Intelibill.Application.csproj", "src/backend/Intelibill.Application/"]
COPY ["src/backend/Intelibill.Domain/Intelibill.Domain.csproj", "src/backend/Intelibill.Domain/"]
COPY ["src/backend/Intelibill.Infrastructure/Intelibill.Infrastructure.csproj", "src/backend/Intelibill.Infrastructure/"]

RUN dotnet restore "src/backend/Intelibill.Api/Intelibill.Api.csproj"

COPY ["src/backend/", "src/backend/"]

# EF tooling constructs the DbContext while generating the bundle but never
# connects to this database. These non-secret values exist only in the discarded
# build stage; the runtime bundle reads its real Database__* configuration.
ENV Database__Host=localhost \
    Database__Database=intelibill_build \
    Database__Username=intelibill_build \
    Database__UseEntraAuth=true

ARG TARGETARCH
RUN dotnet tool install --tool-path /tools dotnet-ef --version 10.0.4 \
    && case "${TARGETARCH}" in \
       amd64) runtime_id="linux-x64" ;; \
       arm64) runtime_id="linux-arm64" ;; \
       *) printf 'Unsupported target architecture: %s\n' "${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && /tools/dotnet-ef migrations bundle \
         --project src/backend/Intelibill.Infrastructure/Intelibill.Infrastructure.csproj \
         --startup-project src/backend/Intelibill.Api/Intelibill.Api.csproj \
         --configuration Release \
         --self-contained \
         --target-runtime "${runtime_id}" \
         --output /out/efbundle

FROM mcr.microsoft.com/dotnet/aspnet:10.0@sha256:a4556ed033fa96f984bb7a8d348851cb2d36b1281dd2420070045f664fbb5f94 AS runtime
WORKDIR /app

# Azure.Identity needs the system CA bundle; Npgsql's integrated authentication
# dependencies load libgssapi even though production uses Entra access tokens.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build --chown=$APP_UID:$APP_UID /out/efbundle /app/efbundle

USER $APP_UID

ENTRYPOINT ["/app/efbundle"]
