{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Wolverine": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "",
    "Port": 5432,
    "Database": "",
    "Username": "",
    "Password": ""
  },
  "DistributedCache": {
    "SchemaName": "public",
    "TableName": "cache_entries",
    "CreateIfNotExists": true,
    "ExpiredItemsDeletionInterval": "00:30:00"
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ExternalAuth": {
    "Google": {
      "Enabled": false,
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "",
      "Scope": "openid email profile",
      "AuthorizationEndpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "TokenEndpoint": "https://oauth2.googleapis.com/token"
    },
    "Microsoft": {
      "TenantId": "common",
      "ClientId": ""
    },
    "Facebook": {
      "AppId": "",
      "AppSecret": "",
      "Enabled": false,
      "RedirectUri": "",
      "Scope": "email",
      "AuthorizationEndpoint": "https://www.facebook.com/v19.0/dialog/oauth",
      "TokenEndpoint": "https://graph.facebook.com/v19.0/oauth/access_token"
    },
    "Twitter": {},
    "Apple": {
      "ClientId": ""
    }
  },
  "App": {
    "BaseUrl": ""
  },
  "ProductLookup": {
    "BaseUrl": "http://localhost:5209",
    "LookupPath": "/api/products/lookup",
    "ApiKey": "dev-api-key-change-in-production"
  },
  "Observability": {
    "Logging": {
      "MinimumLevel": "Error",
      "EnablePiiMasking": true,
      "AsyncBufferSize": 10000
    },
    "Tracing": {
      "SamplingRatio": 0.1,
      "EnableW3CPropagation": true
    },
    "Metrics": {
      "EnableRuntimeMetrics": true
    },
    "NewRelic": {
      "OtlpEndpoint": "https://otlp.nr-data.net:4318",
      "ApiKey": "YOUR_NEW_RELIC_API_KEY",
      "ServiceName": "InteliBill",
      "ServiceVersion": "1.0.0",
      "Environment": "production"
    }
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "SamplingDurationSeconds": 30,
    "MinimumThroughput": 10,
    "BreakDurationSeconds": 30
  }
}
