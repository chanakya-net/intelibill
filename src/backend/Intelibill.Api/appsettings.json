{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Wolverine": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Host": "",
    "Port": 5432,
    "Database": "",
    "Username": "",
    "Password": "",
    "MaxPoolSize": 12,
    "UseEntraAuth": false,
    "ManagedIdentityClientId": ""
  },
  "DistributedCache": {
    "SchemaName": "public",
    "TableName": "cache_entries",
    "CreateIfNotExists": false,
    "ExpiredItemsDeletionInterval": "00:30:00"
  },
  "RateLimiting": {
    "Limit": 100,
    "PeriodInMinutes": 1,
    "BackoffMinutes": 3
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7,
    "SigningMode": "Hmac",
    "KeyVaultKeyId": "",
    "ManagedIdentityClientId": "",
    "SigningKeyRefreshInterval": "00:10:00"
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "UseStartTls": true,
    "Username": "",
    "Password": "",
    "FromEmail": "",
    "FromName": ""
  },
  "App": {
    "BaseUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Proxy": {
    "Enabled": false,
    "ForwardLimit": 1,
    "TrustAnyProxy": false,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "ProductLookup": {
    "BaseUrl": "http://localhost:5209",
    "LookupPath": "/api/products/lookup",
    "ApiKey": "test-api-key-12345"
  },
  "Observability": {
    "Logging": {
      "MinimumLevel": "Error",
      "EnablePiiMasking": true,
      "AsyncBufferSize": 10000
    },
    "Tracing": {
      "SamplingRatio": 0.5,
      "EnableW3CPropagation": true
    },
    "Metrics": {
      "EnableRuntimeMetrics": true
    },
    "NewRelic": {
      "OtlpEndpoint": "https://otlp.nr-data.net:4318",
      "ApiKey": "YOUR_NEW_RELIC_API_KEY",
      "ServiceName": "InteliBill",
      "ServiceVersion": "1.0.0",
      "Environment": "production"
    }
  },
  "CircuitBreaker": {
    "FailureThreshold": 5,
    "SamplingDurationSeconds": 30,
    "MinimumThroughput": 10,
    "BreakDurationSeconds": 30
  }
}
