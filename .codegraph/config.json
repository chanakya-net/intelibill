{
  "version": 1,
  "include": [
    "**/*.cs",
    "**/*.ts",
    "**/*.tsx",
    "**/*.dart",
    "**/*.html",
    "**/*.json"
  ],
  "exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/build/**",
    "**/.dart_tool/**",
    "**/coverage/**",
    "**/TestResults/**",
    "**/*.min.js"
  ],
  "maxFileSize": 1048576,
  "extractDocstrings": true,
  "trackCallSites": true
}