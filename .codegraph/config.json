{
  "version": 1,
  "include": [
    "src/backend/**/*.cs",
    "src/frontend/**/*.ts",
    "src/frontend/**/*.tsx",
    "src/frontend/**/*.html",
    "src/mobile/android/intelibill_mobile/**/*.dart",
    "src/mobile/android/intelibill_mobile/**/*.html",
    "src/mobile/android/intelibill_mobile/**/*.json",
    "tests/**/*.cs"
  ],
  "exclude": [
    "**/.git/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**",
    "**/dist/**",
    "**/build/**",
    "**/.dart_tool/**",
    "**/coverage/**",
    "**/TestResults/**",
    "**/*.min.js",
    "**/*.g.dart",
    "**/*.freezed.dart",
    "src/mobile/android/intelibill_mobile/android/**",
    "src/mobile/android/intelibill_mobile/build/**"
  ],
  "maxFileSize": 1048576,
  "extractDocstrings": true,
  "trackCallSites": true
}